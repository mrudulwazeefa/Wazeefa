# Mail Configuration for Email Delivery
# Copy this file to .env and fill in your actual values

# Recipient Addresses
MAIL_TO_CONTACT=mrudul@gmail.com
MAIL_TO_CAREER=mrudul1@gmail.com

# From Address (use your domain or Gmail address)
MAIL_FROM=no-reply@yourdomain.com

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true

# For Gmail: 
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password as SMTP_PASS
# 4. Keep SMTP_SECURE=tls and SMTP_PORT=587
